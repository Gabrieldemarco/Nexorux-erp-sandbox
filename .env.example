# Application
APP_NAME=NEXORUX ERP
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://nexorux:nexorux123@localhost:5432/nexorux_dev
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=dev-secret-key-change-in-production
# SECRET_KEY_FILE=/run/secrets/secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
LOCKOUT_USE_REDIS=true
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
RLS_TENANT_CONTEXT_ENABLED=true
STOCK_ALLOW_NEGATIVE=false
TRUSTED_HOSTS=localhost,127.0.0.1,nexorux-erp.local

# CORS (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Password recovery / email
# Local Mailpit (NO llega a Gmail): SMTP_HOST=127.0.0.1 SMTP_PORT=1025
# Gmail real: ver docs/EMAIL.md
EMAIL_BACKEND=smtp
SMTP_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
SMTP_FROM=noreply@nexorux.local
SMTP_USE_TLS=false
SMTP_USE_SSL=false
PASSWORD_RESET_URL_BASE=http://localhost:3000/recover-password

# DGI Integration
DGI_ENVIRONMENT=testing
DGI_WS_URL=
DGI_CERT_PATH=
DGI_KEY_PATH=
DGI_KEY_PASSWORD=
CFE_XSD_PATH=
CFE_XSD_VALIDATION_REQUIRED=false

# WooCommerce
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage

# Logging
LOG_LEVEL=INFO

# Production compose extras (host env, not always in backend .env)
# NEXORUX_DOMAIN=localhost
# CADDY_ACME_EMAIL=ops@localhost
# NEXORUX_TRUSTED_HOSTS=localhost,127.0.0.1,erp.tudominio.com,backend
# NEXORUX_CORS_ORIGINS=https://erp.tudominio.com
