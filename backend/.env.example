# Application
APP_NAME=NEXORUX ERP
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://nexorux:nexorux123@localhost:5432/nexorux_dev
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOCKOUT_USE_REDIS=true
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Required when FORCE RLS is applied — app must set app.current_tenant_id via get_db
RLS_TENANT_CONTEXT_ENABLED=true
# Reject sales that would leave stock below zero (set true only for special cases)
STOCK_ALLOW_NEGATIVE=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# DGI Integration
DGI_ENVIRONMENT=testing
DGI_WS_URL=
# Paths to ePrueba signing material (PEM). Required for live --send.
DGI_CERT_PATH=
DGI_KEY_PATH=
# DGI_KEY_PASSWORD=
CFE_XSD_VALIDATION_REQUIRED=false

# WooCommerce MVP webhook (optional). If set, accept X-Nexorux-Webhook-Secret.
# When using secret without JWT, also send X-Nexorux-Tenant-Id and X-Nexorux-Company-Id.
WOOCOMMERCE_WEBHOOK_SECRET=
# Optional: push stock Nexorux → Woo (REST API keys from Woo > Settings > Advanced > REST API)
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Logging
LOG_LEVEL=INFO

# Password recovery — Mailpit local NO llega a Gmail (docs/EMAIL.md)
EMAIL_BACKEND=smtp
SMTP_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM=noreply@nexorux.local
PASSWORD_RESET_URL_BASE=http://localhost:3000/recover-password
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USE_TLS=true + USER/PASSWORD/FROM

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Rate Limiting (requests per minute in debug mode)
RATE_LIMIT_MAX_REQUESTS=60

# Trusted Hosts (comma-separated)
TRUSTED_HOSTS=localhost,127.0.0.1,nexorux-erp.local
